{
  "expo": {
    "name": "GiroCash",
    "slug": "girocash",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#0f172a"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.girocash.app"
    },
    "android": {
      "package": "com.girocash.app"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": ["expo-router"],
    "scheme": "girocash"
  }
}
